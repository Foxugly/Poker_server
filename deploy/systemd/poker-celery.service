[Unit]
Description=Delegation Poker — Celery worker (async tasks)
After=network.target poker-env-fetch.service redis-server.service
Requires=poker-env-fetch.service

[Service]
User=django
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django_websites/Poker_server
EnvironmentFile=/run/poker/.env
# --pool=solo: the worker runs tasks itself, no child process. One task only
# (rooms.tasks.expire_stale_rooms, every 15 min): two prefork children cost ~200 MB on a RAM-bound
# box (OPERATIONS.md §3.22).
ExecStart=/var/www/django_websites/Poker_server/.venv/bin/celery -A config worker -l info --pool=solo
# Hardening (OPERATIONS.md §3.22): no privilege escalation, private /tmp, read-only
# system (/usr, /boot, /etc). Never ProtectSystem=strict: /var/www (media, beat schedule)
# must stay writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
